<div class="character-sheet-content">

  <header class="sheet-header">
    <img
      src="{{actor.img}}"
      data-edit="img"
      width="100"
      height="100"
    >

    <div class="identity-block">
      <label>
        Nombre
        <input
          name="name"
          type="text"
          value="{{actor.name}}"
        >
      </label>

      <label>
        Nivel
        <input
          type="number"
          name="system.level"
          value="{{system.level}}"
        >
      </label>
    </div>
  </header>

  <hr>

  <section class="abilities-section">
    <h2>Características</h2>

    <div class="abilities-grid">

  <div class="ability-card">
    <span class="ability-name">STR</span>
    <span class="ability-modifier">{{formatedModifiers.str}}</span>
    <input class="ability-score" type="number"
      name="system.abilities.str"
      value="{{system.abilities.str}}">
  </div>

  <div class="ability-card">
    <span class="ability-name">DEX</span>
    <span class="ability-modifier">{{modifiers.dex}}</span>
    <input class="ability-score" type="number"
      name="system.abilities.dex"
      value="{{system.abilities.dex}}">
  </div>

  <div class="ability-card">
    <span class="ability-name">CON</span>
    <span class="ability-modifier">{{formatedModifiers.con}}</span>
    <input class="ability-score" type="number"
      name="system.abilities.con"
      value="{{system.abilities.con}}">
  </div>

  <div class="ability-card">
    <span class="ability-name">INT</span>
    <span class="ability-modifier">{{formatedModifiers.int}}</span>
    <input class="ability-score" type="number"
      name="system.abilities.int"
      value="{{system.abilities.int}}">
  </div>

  <div class="ability-card">
    <span class="ability-name">WIS</span>
    <span class="ability-modifier">{{formatedModifiers.wis}}</span>
    <input class="ability-score" type="number"
      name="system.abilities.wis"
      value="{{system.abilities.wis}}">
  </div>

  <div class="ability-card">
    <span class="ability-name">CHA</span>
    <span class="ability-modifier">{{formatedModifiers.cha}}</span>
    <input class="ability-score" type="number"
      name="system.abilities.cha"
      value="{{system.abilities.cha}}">
  </div>

</div>
  </section>

  <hr>

  <section class="combat-section">
    <h2>Combate</h2>

    <div class="combat-grid">

      <label>
        HP actual
        <input
          type="number"
          name="system.hp.value"
          value="{{system.hp.value}}"
        >
      </label>

      <label>
        HP máximo
        <input
          type="number"
          name="system.hp.max"
          value="{{system.hp.max}}"
        >
      </label>

      <label>
        AC
        <input
          type="number"
          name="system.ac"
          value="{{system.ac}}"
        >
      </label>

      <label>
        PB
        <input
          type="number"
          name="system.proficiency"
          value="{{system.proficiency}}"
        >
      </label>

    </div>
  </section>

</div>